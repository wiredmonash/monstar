{
  "name": "backend",
  "version": "1.0.0",
  "description": "MonSTAR Server",
  "main": "index.js",
  "scripts": {
    "test": "jest --selectProjects services integration",
    "test:integration": "jest --selectProjects integration",
    "test:perf": "jest --selectProjects performance",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --strict --noImplicitAny --allowJs false",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "dev": "npm run build && (tsc -w & nodemon --watch dist --delay 2 dist/server.js)",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "WIRED Monash",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "~1.34.0",
    "@upstash/redis": "~1.36.0",
    "axios": "1.13.5",
    "bcrypt": "5.1.1",
    "cloudinary": "1.41.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csurf": "1.11.0",
    "dotenv": "17.2.3",
    "express": "4.22.1",
    "express-async-handler": "~1.2.0",
    "google-auth-library": "~9.15.1",
    "jsonwebtoken": "~9.0.3",
    "module-alias": "^2.2.3",
    "mongoose": "~8.21.0",
    "multer": "2.0.2",
    "multer-storage-cloudinary": "4.0.0",
    "nodemailer": "~7.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "artillery": "2.0.27",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.5.0",
    "ioredis-mock": "^8.13.1",
    "jest": "30.2.0",
    "mongodb-memory-server": "11.0.1",
    "mongoose-to-swagger": "1.5.1",
    "nodemon": "3.1.11",
    "prettier": "3.7.4",
    "supertest": "^7.2.2",
    "swagger-autogen": "2.23.7",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "artillery": {
      "@opentelemetry/api": "1.9.0"
    }
  },
  "_moduleAliases": {
    "@models": "./models",
    "@routes": "./infra/routes",
    "@controllers": "./infra/controllers",
    "@providers": "./infra/providers",
    "@middleware": "./infra/middleware",
    "@services": "./infra/services",
    "@repositories": "./infra/repositories",
    "@utilities": "./infra/utilities",
    "@constants": "./constants",
    "@docs": "./docs"
  }
}
