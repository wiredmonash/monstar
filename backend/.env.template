# Backend environment template. Copy to backend/.env (gitignored):
#
#   cp backend/.env.template backend/.env
#
# The defaults below work as-is for the Docker Compose setup, where
# MONGODB_CONN_STRING, PORT, DEVELOPMENT, and PRODUCTION_MACHINE are set by
# compose.yaml and override the values here. For the manual (npm) setup,
# point MONGODB_CONN_STRING at your own MongoDB instance.

# MongoDB connection string (ignored under Docker Compose)
MONGODB_CONN_STRING='your-mongodb-connection-string'
# Port of the backend server (8080 is fine)
PORT=8080
# Environment for development or production
DEVELOPMENT=true
# Is this running on the production machine?
PRODUCTION_MACHINE=false

# Secret key for signing JWTs. Any random string works for local development.
JWT_SECRET=local-dev-only-not-a-secret

# This is for logging in with google
GOOGLE_CLIENT_ID='671526426147-a16p1qi3iq3mtf672f7ka5hlpq8mvl3d.apps.googleusercontent.com'

# --- Everything below is optional; the related features degrade gracefully ---

# Email account used for nodemailer
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Cloudinary (profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Google Gemini Generative AI (unit AI overviews)
GEMINI_API_KEY=
GEMINI_MODEL=

# Upstash serverless Redis (HTTP/REST connection); falls back to in-memory cache
MONSTAR_SERVERLESS_CACHE_KV_REST_API_TOKEN=
MONSTAR_SERVERLESS_CACHE_KV_REST_API_URL=

# Notion page ID for the jobs board
NOTION_PAGE_ID=

# EMAIL jenul15ferdinand@gmail.com if you need help setting up your environment
