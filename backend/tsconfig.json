{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@domains/*": ["./src/domains/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@shared/*": ["./src/shared/*"],
      "@docs/*": ["./src/docs/*"]
    },
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "scrapers"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
