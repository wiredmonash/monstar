# Development image: source is bind-mounted by compose.yaml, so this image
# only needs Node and the installed dependencies. tsx watch provides reload.
# glibc-based (not alpine) because bcrypt only ships prebuilt glibc binaries.
FROM node:24-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 8080

CMD ["npm", "run", "dev"]
